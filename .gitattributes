# 脚本 / 配置 / 工作流一律 LF：这些文件会被 adb push 到 Android 并直接被
# /system/bin/sh、awk、yaml 解析器读取，CRLF 会让 shebang 变成 "sh\r" 而整套脚本失效。
Adguardhome/scripts/** text eol=lf
Adguardhome/*.sh text eol=lf
Adguardhome/*.prop text eol=lf
Adguardhome/bin/*.yaml text eol=lf
Adguardhome/smartdns/etc/** text eol=lf
Adguardhome/scripts/catalog/** text eol=lf
.github/workflows/*.yml text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.awk text eol=lf
*.rewrite text eol=lf
*.prop text eol=lf
*.conf text eol=lf
*.html text eol=lf

# 二进制不做行尾转换
Adguardhome/bin/AdGuardHome binary
Adguardhome/bin/dnsenc binary
Adguardhome/bin/aghmitm binary
Adguardhome/smartdns/usr/** binary
