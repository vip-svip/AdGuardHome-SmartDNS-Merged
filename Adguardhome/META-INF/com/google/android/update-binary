#!/sbin/sh
# Magisk 标准模块安装器入口。KernelSU/APatch 的 ksud 会忽略本文件、直接读 customize.sh，
# 所以这里只保留上游模板，保证同一个 zip 在 Magisk 上也能刷。
umask 022

ui_print() { echo "$1"; }

require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk

install_module
exit 0