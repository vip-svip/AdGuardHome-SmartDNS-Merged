[Argument]
displayUpList=select, "show", "hide", "auto", tag=[动态]中[最常访问]的显示方式, desc=auto：仅当列表中存在直播状态时显示；show：始终显示；hide：始终隐藏。
purifyComment=switch, true, false, tag=移除评论区置顶广告, desc=移除评论区置顶广告
optimizeRequest=switch, true, false, tag=优化评论区加载异常, desc=尝试解决评论区加载异常的问题
sponsorBlock=switch, false, true, tag=空降助手, desc=用于跳过视频中的广告
logLevel=select, "off", "error", "warn", "info", "debug", tag=日志等级, desc=脚本的日志输出等级
removePinnedArticles = switch, false, true, tag=移除置顶文章, desc=启用后将移除置顶文章
removeAllBanners = switch, false, true, tag=移除全部横幅, desc=启用后将移除全部横幅
MY=switch, false, true, tag=[隐藏底栏]漫游标签, desc=
DT=switch, false, true, tag=[隐藏底部]笔记标签, desc=
FX=switch, false, true, tag=[隐藏底部]发现标签, desc=
PRGG=switch, false, true, tag=[隐藏首页]问候语, desc=
PRRK=switch, false, true, tag=[隐藏首页]排行榜, desc=
PRDRD=switch, false, true, tag=[隐藏首页]每日推荐, desc=
PRSCVPT=switch, false, true, tag=[隐藏首页]推荐歌单, desc=
PRST=switch, false, true, tag=[隐藏首页]最近常听, desc=
PRRR=switch, false, true, tag=[隐藏首页]雷达歌单, desc=
HMPR=switch, false, true, tag=[隐藏首页]音乐合伙人, desc=
PRMST=switch, false, true, tag=[隐藏首页]推荐专属歌单, desc=
PRCN=switch, false, true, tag=[隐藏首页]你的专属歌单, desc=
per_filter_video_thread=select, "true", "false", tag=拦截推荐页面视频帖, desc=此项决定是否拦截首页推荐标签下的视频帖
