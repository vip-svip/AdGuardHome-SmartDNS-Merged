#!name=Billboard Ranking
#!desc=美国公告牌面板。在插件界面将想要显示的条目数量填入songCount，想要的榜单类型（有四种类型：billboard-200，billboard-artist-100，billboard-global-200，billboard-hot-100）填入sort。不填默认展示前5条billboard-hot-100
#!input=songCount
#!input=sort
#!homepage=https://yfamilys.com

[Script]
cron "0 0 12 ? * WED" script-path=https://raw.githubusercontent.com/deezertidal/private/main/bb100.js, timeout=10, tag=Billboard