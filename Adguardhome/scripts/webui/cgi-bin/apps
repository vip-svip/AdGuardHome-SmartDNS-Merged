#!/system/bin/sh
# 应用分流 CGI
#   GET  /cgi-bin/apps                     -> {"apps":[{pkg,uid,state}...]}  state: normal|bypass|force
#   GET  /cgi-bin/apps?set=PKG&mode=MODE   -> 写入 绕过/强制 名单并触发规则重建
# MODE: normal | bypass | force
#
# 性能说明：旧版对每个包（380 个）各跑 3 次 grep 判断状态，
# 单次 GET 实测 19.1s（Android 上 fork 一次约 25~35ms）。
# 现在整张列表由一次 awk 完成（读 CACHE/BYPASS/FORCE 到内存后一次遍历）。
DIR=/data/adb/agh
BYPASS="$DIR/apps_bypass.txt"
FORCE="$DIR/apps_force.txt"
CACHE="$DIR/.pm_uids"

cors() {
    printf 'Cache-Control: no-store, no-cache, must-revalidate\r\n'
    printf 'Access-Control-Allow-Origin: *\r\n'
    printf 'Access-Control-Allow-Methods: GET, OPTIONS\r\n'
    printf 'Access-Control-Allow-Headers: *\r\n'
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf '\r\n'
}
case "$REQUEST_METHOD" in OPTIONS) cors; exit 0 ;; esac

[ -f "$BYPASS" ] || : > "$BYPASS" 2>/dev/null
[ -f "$FORCE" ] || : > "$FORCE" 2>/dev/null

# 包名 → uid（缓存，packages.xml 更新后失效）
pm_cache() {
    _need=0
    [ -s "$CACHE" ] || _need=1
    if [ "$_need" = "0" ] && [ -f /data/system/packages.xml ] && [ "$CACHE" -ot /data/system/packages.xml ]; then
        _need=1
    fi
    if [ "$_need" = "1" ]; then
        pm list packages -U 2>/dev/null | sed -n 's/^package:\([^ ]*\) uid:\([0-9]*\).*/\1 \2/p' > "$CACHE.tmp" 2>/dev/null
        [ -s "$CACHE.tmp" ] && mv -f "$CACHE.tmp" "$CACHE"
    fi
}

Q="$QUERY_STRING"
case "$Q" in
    set=*)
        pkg=$(printf '%s' "$Q" | sed -n 's/.*set=\([^&]*\).*/\1/p')
        mode=$(printf '%s' "$Q" | sed -n 's/.*mode=\([^&]*\).*/\1/p')
        case "$pkg" in ""|*/*|*..*) cors; printf '{"ok":false,"error":"bad package"}\n'; exit 0 ;; esac
        case "$mode" in normal|bypass|force) ;; *) cors; printf '{"ok":false,"error":"bad mode"}\n'; exit 0 ;; esac
        pm_cache
        uid=$(awk -v p="$pkg" '$1==p{print $2; exit}' "$CACHE" 2>/dev/null)
        [ -n "$uid" ] || { cors; printf '{"ok":false,"error":"uid not found"}\n'; exit 0; }
        # 只维护自身名单，幂等
        grep -vx "$uid" "$BYPASS" > "$BYPASS.tmp" 2>/dev/null; mv "$BYPASS.tmp" "$BYPASS" 2>/dev/null
        grep -vx "$uid" "$FORCE"  > "$FORCE.tmp"  2>/dev/null; mv "$FORCE.tmp"  "$FORCE"  2>/dev/null
        case "$mode" in
            bypass) echo "$uid" >> "$BYPASS" ;;
            force)  echo "$uid" >> "$FORCE" ;;
        esac
        setsid sh /data/adb/agh/scripts/iptables.sh --once >/dev/null 2>&1 &
        cors
        printf '{"ok":true,"pkg":"%s","uid":"%s","mode":"%s"}\n' "$pkg" "$uid" "$mode"
        exit 0
        ;;
esac

pm_cache
cors
awk -v byp="$BYPASS" -v frc="$FORCE" -v cache="$CACHE" '
    function trim(s) { gsub(/[ \t\r]/, "", s); return s }
    BEGIN {
        nb = 0
        while ((getline l < byp) > 0) {
            l = trim(l); if (l == "") continue
            if (!(l in bs)) { bs[l] = 1; bl[++nb] = l }
        }
        close(byp)
        nf = 0
        while ((getline l < frc) > 0) {
            l = trim(l); if (l == "") continue
            if (!(l in fs)) { fs[l] = 1; fl[++nf] = l }
        }
        close(frc)
        printf "{\"ok\":true,\"bypass\":["
        for (i = 1; i <= nb; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), bl[i]
        printf "],\"force\":["
        for (i = 1; i <= nf; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), fl[i]
        printf "],\"apps\":["
        first = 1
    }
    {
        pkg = trim($1); uid = trim($2)
        if (pkg == "" || uid == "") next
        # 系统包太多（380+），默认不列；除非用户在名单里操作过
        if (pkg ~ /^(android|com\.android\.|com\.google\.android\.|com\.miui\.|com\.oplus\.)/ \
            && !(uid in bs) && !(uid in fs)) next
        st = (uid in fs) ? "force" : ((uid in bs) ? "bypass" : "normal")
        printf "%s{\"pkg\":\"%s\",\"uid\":\"%s\",\"state\":\"%s\"}", (first ? "" : ","), pkg, uid, st
        first = 0
    }
    END { printf "]}\n" }
' "$CACHE" 2>/dev/null
