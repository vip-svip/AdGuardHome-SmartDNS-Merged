#!/system/bin/sh
# MITM 运行时控制 CGI
#   GET /cgi-bin/mitm                      状态：进程、端口、已接管 uid 数、规则数
#   GET /cgi-bin/mitm?cmd=on|off           启停（写/删 mitm_on，启停 aghmitm 进程）
#   GET /cgi-bin/mitm?add=PKG / ?del=PKG   按包名增删「透明接管」名单（写 mitm_uids.txt 并重建）
DIR=/data/adb/agh
BIN=/data/adb/modules/AdGuardHome/bin/aghmitm
UIDF="$DIR/mitm_uids.txt"
LOG="$DIR/mitm.log"

# AGH 的 DNS 端口：运行配置在 $DIR/bin/AdGuardHome.yaml（AGH 实际从这里启动），
# modules/ 下那份只是模板。先读运行配置，再用实际监听端口兜底，最后读 config.prop。
agh_dns_port() {
    _p=$(awk '/^dns:/{f=1} f&&/^[[:space:]]+port:/{print $2; exit}' "$DIR/bin/AdGuardHome.yaml" 2>/dev/null)
    case "$_p" in ''|*[!0-9]*)
        _p=$(awk '/^dns:/{f=1} f&&/^[[:space:]]+port:/{print $2; exit}' /data/adb/modules/AdGuardHome/bin/AdGuardHome.yaml 2>/dev/null) ;;
    esac
    case "$_p" in ''|*[!0-9]*)
        _p=$(netstat -tlnup 2>/dev/null | grep AdGuardHome | grep udp | sed -n 's/.*[:.]\([0-9]*\) .*/\1/p' | head -1) ;;
    esac
    case "$_p" in ''|*[!0-9]*)
        _p=$(grep -oE '^redir_port=[0-9]+' "$DIR/scripts/config.prop" 2>/dev/null | cut -d= -f2) ;;
    esac
    echo "${_p:-5591}"
}

start_mitm() {
    pidof aghmitm >/dev/null 2>&1 && return 0
    setsid "$BIN" -listen 127.0.0.1:8899 -rules "$DIR/scripts/rewrite" \
        -dns "127.0.0.1:$(agh_dns_port)" >>"$LOG" 2>&1 &
}

cors() {
    printf 'Cache-Control: no-store, no-cache, must-revalidate\r\n'
    printf 'Access-Control-Allow-Origin: *\r\n'
    printf 'Access-Control-Allow-Methods: GET, OPTIONS\r\n'
    printf 'Access-Control-Allow-Headers: *\r\n'
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf '\r\n'
}
case "$REQUEST_METHOD" in OPTIONS) cors; exit 0 ;; esac
[ -f "$UIDF" ] || : > "$UIDF" 2>/dev/null

pkg_uid() {
    _c="$DIR/.pm_uids"
    [ -s "$_c" ] || pm list packages -U 2>/dev/null | sed -n 's/^package:\([^ ]*\) uid:\([0-9]*\).*/\1 \2/p' > "$_c" 2>/dev/null
    awk -v p="$1" '$1==p{print $2; exit}' "$_c" 2>/dev/null
}

# 名单为空时播种浏览器类应用的 uid —— 否则没有任何 443 流量被 REDIRECT，
# 脚本里的 JS 与头改规则即使加载也不会执行。
seed_uids() {
    [ -s "$UIDF" ] && return 0
    _c="$DIR/.pm_uids"
    [ -s "$_c" ] || pm list packages -U 2>/dev/null | sed -n 's/^package:\([^ ]*\) uid:\([0-9]*\).*/\1 \2/p' > "$_c" 2>/dev/null
    [ -s "$_c" ] || return 0
    awk '$1 ~ /(chrome|chromium|firefox|browser|quark|ucmobile|ucweb|mtt|searchbox|via|emmx|sbrowser|brave|opera|vivaldi)/ {
        print $2
    }' "$_c" 2>/dev/null | sort -u > "$UIDF.t" 2>/dev/null
    if [ -s "$UIDF.t" ]; then mv "$UIDF.t" "$UIDF" 2>/dev/null; else rm -f "$UIDF.t" 2>/dev/null; fi
}

# 全量接管：所有第三方应用（uid>=10000）
seed_all() {
    _c="$DIR/.pm_uids"
    [ -s "$_c" ] || pm list packages -U 2>/dev/null | sed -n 's/^package:\([^ ]*\) uid:\([0-9]*\).*/\1 \2/p' > "$_c" 2>/dev/null
    awk '$2 >= 10000 {print $2}' "$_c" 2>/dev/null | sort -u > "$UIDF" 2>/dev/null
    setsid sh "$DIR/scripts/iptables.sh" --once >/dev/null 2>&1 &
}

Q="$QUERY_STRING"
case "$Q" in
    cmd=on*)
        : > "$DIR/mitm_on"
        seed_uids
        start_mitm
        rm -f /data/adb/agh/.mitm_resp 2>/dev/null

        sleep 1
        setsid sh "$DIR/scripts/iptables.sh" --once >/dev/null 2>&1 &
        sleep 1
        cors; printf '{"ok":true,"running":%s,"uids":%s}\n' "$([ -n "$(pidof aghmitm)" ] && echo 1 || echo 0)" "$(grep -c . "$UIDF" 2>/dev/null)"
        exit 0 ;;
    all=1*|all=on*)
        : > "$DIR/mitm_on"
        seed_all
        rm -f /data/adb/agh/.mitm_resp 2>/dev/null
        sleep 1
        start_mitm

        sleep 1
        cors; printf '{"ok":true,"running":%s,"uids":%s}\n' "$([ -n "$(pidof aghmitm)" ] && echo 1 || echo 0)" "$(grep -c . "$UIDF" 2>/dev/null)"
        exit 0 ;;
    cmd=off*)
        rm -f "$DIR/mitm_on"
        rm -f /data/adb/agh/.mitm_resp 2>/dev/null
        pidof aghmitm | xargs -r kill 2>/dev/null
        cors; printf '{"ok":true,"running":0}\n'
        exit 0 ;;
    add=*|del=*)
        pkg=$(printf '%s' "$Q" | sed -n 's/^\(add\|del\)=\([^&]*\).*/\2/p')
        op=${Q%%=*}
        case "$pkg" in ""|*/*|*..*) cors; printf '{"ok":false,"error":"bad pkg"}\n'; exit 0 ;; esac
        u=$(pkg_uid "$pkg")
        [ -n "$u" ] || { cors; printf '{"ok":false,"error":"uid not found"}\n'; exit 0; }
        grep -vx "$u" "$UIDF" > "$UIDF.t" 2>/dev/null; mv "$UIDF.t" "$UIDF" 2>/dev/null
        [ "$op" = "add" ] && echo "$u" >> "$UIDF"
        rm -f /data/adb/agh/.mitm_resp 2>/dev/null
        setsid sh "$DIR/scripts/iptables.sh" --once >/dev/null 2>&1 &
        cors; printf '{"ok":true,"pkg":"%s","uid":"%s","mode":"%s"}\n' "$pkg" "$u" "$op"
        exit 0 ;;
esac

# 状态响应（含响应头）缓存：命中只需一次 cat（~40ms），
# 启停/增删名单后统一 rm 掉缓存强制重建。
RESP=/data/adb/agh/.mitm_resp
build_resp() {
    {
        cors
        _rd=$(iptables -t nat -S OUTPUT 2>/dev/null | grep -c '8899')
        printf '{"running":%s,"pid":"%s","port":8899,"uids":%s,"rules":%s,"js":%s,"log":"%s","on":%s,"redirect":%s,"warn":"%s"}\n' \
            "$([ -n "$(pidof aghmitm)" ] && echo 1 || echo 0)" "$(pidof aghmitm 2>/dev/null)" \
            "$(grep -c . "$UIDF" 2>/dev/null)" \
            "$(grep -c 'url' "$DIR/scripts/rewrite"/* 2>/dev/null | awk -F: '{s+=$2} END{print s+0}')" \
            "$(js_n)" "$LOG" \
            "$([ -f "$DIR/mitm_on" ] && echo 1 || echo 0)" "${_rd:-0}" "$(mitm_warn)"
    } > "$RESP.tmp" 2>/dev/null
    [ -s "$RESP.tmp" ] && mv -f "$RESP.tmp" "$RESP" 2>/dev/null
    return 0
}
js_n() {
    _j=0
    for _f in "$DIR"/scripts/rewrite/*.js "$DIR"/scripts/rewrite/js/*.js; do
        [ -f "$_f" ] && _j=$((_j + 1))
    done
    echo "$_j"
}

# 一致性校验：开关开 + 名单空 = 没有任何 443 被接管（真机上踩过的静默坏状态）
mitm_warn() {
    [ -f "$DIR/mitm_on" ] || { echo ""; return 0; }
    [ -s "$UIDF" ] && { echo ""; return 0; }
    echo "接管名单为空，443 没有被 MITM 接管（守护自愈会在 5 秒内播种浏览器类应用）"
}

case "$QUERY_STRING" in
    *rebuild=*) rm -f "$RESP" 2>/dev/null ;;
esac
# 轻量失效判定：名单/开关文件比缓存新就重建（-nt 是 shell 内建，不 fork）
if [ -f "$RESP" ]; then
    [ "$UIDF" -nt "$RESP" ] && rm -f "$RESP" 2>/dev/null
    [ -f "$DIR/mitm_on" ] && [ "$DIR/mitm_on" -nt "$RESP" ] && rm -f "$RESP" 2>/dev/null
fi
if [ -s "$RESP" ]; then
    cat "$RESP" 2>/dev/null
else
    build_resp
    cat "$RESP" 2>/dev/null || { cors; printf '{"running":0,"error":"build failed"}\n'; }
fi
