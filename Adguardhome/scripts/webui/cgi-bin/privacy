#!/system/bin/sh
# 隐私防护 CGI：读写 /data/adb/agh/privacy.conf 并应用 iptables 规则
#
# 设计变更（v2）：
#   1) GET 是纯只读，绝不重建 iptables —— 重建只在 POST / --apply 时发生。
#      旧版 GET 每次都 apply()：-F 后重加 ~40 条规则，实测 1.6~2.7s，
#      前端开关在拿到响应前只能按默认值渲染 → 刷新时「关一下再打开」。
#   2) GET 优先回缓存（毫秒级）；真值全部来自本机 conf / iptables。
#      （旧版在这里查 AGH 的 safebrowsing / parental 引擎，缓存值与引擎实际状态
#        不一致时，页面首帧画「已关闭」、异步回来再翻「已开启」→ 那一下闪烁。
#        这两个开关已整体删除，不再有异步真值。）
#   3) apply() 先建暂存链再原子换挂（iptables -E 会同步更新引用），
#      不再有「链已清空、规则未加」的裸奔段；并合并 multiport 减少 fork。
#   4) 规则集未变（sig 相同且链在挂）时直接跳过重建。
#
# GET  -> {"dns":1,"vpn":1,"ip":1,"ntp":1,...,"applied":1}
# POST -> body: dns=1&vpn=0&ip=1&ntp=1
# CLI  -> sh privacy --apply   (开机/守护调用，只建规则)
#         sh privacy --refresh (后台刷新 AGH 状态并写缓存)
CONF=/data/adb/agh/privacy.conf
CHAIN=AGH_PRIV
STAGE=AGH_PRIV_N
STATE=/data/adb/agh/.privacy_state.json
RESP=/data/adb/agh/.privacy_resp
STAMP=/data/adb/agh/.privacy_applied

cors() {
    printf 'Cache-Control: no-store, no-cache, must-revalidate\r\n'
    printf 'Access-Control-Allow-Origin: *\r\n'
    printf 'Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n'
    printf 'Access-Control-Allow-Headers: *\r\n'
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf '\r\n'
}

# 纯 shell 内建解析（零 fork）。旧版是 fork 一次 awk + 一次 eval，
# 在低端机上光这两下就 30~40ms；GET 走同步 XHR，是首屏关键路径，fork 必须省。
# 键白名单 + 值只接受 0/1，eval 不会注入。
load_conf() {
    DNS=1; VPN=1; IP=1; NTP=1; DHCP=1; SMB=1; TCP=1; SNMP=1
    [ -f "$CONF" ] || return 0
    while IFS='=' read -r _k _v; do
        _v=${_v%%[!0-9]*}
        case "$_k" in
            dns)  case "$_v" in 0) DNS=0 ;; 1) DNS=1 ;; esac ;;
            vpn)  case "$_v" in 0) VPN=0 ;; 1) VPN=1 ;; esac ;;
            ip)   case "$_v" in 0) IP=0 ;; 1) IP=1 ;; esac ;;
            ntp)  case "$_v" in 0) NTP=0 ;; 1) NTP=1 ;; esac ;;
            dhcp) case "$_v" in 0) DHCP=0 ;; 1) DHCP=1 ;; esac ;;
            smb)  case "$_v" in 0) SMB=0 ;; 1) SMB=1 ;; esac ;;
            tcp)  case "$_v" in 0) TCP=0 ;; 1) TCP=1 ;; esac ;;
            snmp) case "$_v" in 0) SNMP=0 ;; 1) SNMP=1 ;; esac ;;
        esac
    done < "$CONF"
    return 0
}

save_conf() {
    printf 'dns=%s\nvpn=%s\nip=%s\nntp=%s\ndhcp=%s\nsmb=%s\ntcp=%s\nsnmp=%s\n' \
        "$DNS" "$VPN" "$IP" "$NTP" "$DHCP" "$SMB" "$TCP" "$SNMP" > "$CONF" 2>/dev/null
}

# 静态页面里的首屏真值行（cgi 在同目录的上一级）
# busybox httpd 跑 CGI 时 $0 只有文件名（没有目录），PWD 又在 cgi-bin 里，
# 单靠 $0 推导会得到「privacy/../privacy.html」这种死路径 —— [ -f ] 永远 false，
# 内联真值于是从安装以来一次都没被更新过（页面首帧一直显示旧状态）。
# 先按固定安装路径找，找不到再退到 $0 推导、再退到上一级目录。
HTML=/data/adb/agh/scripts/webui/privacy.html
[ -f "$HTML" ] || HTML="${0%/*}/../privacy.html"
[ -f "$HTML" ] || HTML="../privacy.html"

# 把当前状态原地写回 privacy.html 的 `window.__AGH_PRIV={...};` 那一行。
# 作用：首屏不再需要 ?embed=1 的二次 CGI 请求（静态文件 30ms 级就到），
# 页面第一帧即最终值 —— 浏览器没机会把上一帧（旧的「已关闭」）留在屏幕上。
# 内容没变就不写（避免每次都刷新 mtime，打掉浏览器缓存的意义）。
inline_write() {
    [ -f "$HTML" ] || return 0
    _il=$(printf 'window.__AGH_PRIV={"dns":%s,"vpn":%s,"ip":%s,"ntp":%s,"dhcp":%s,"smb":%s,"tcp":%s,"snmp":%s};' \
        "$DNS" "$VPN" "$IP" "$NTP" "$DHCP" "$SMB" "$TCP" "$SNMP")
    # 旧版用 `^window.__AGH_PRIV=` 做行首匹配，可实际 HTML 里那行前面有缩进
    # → grep 永远匹配不上、awk 也替换不了 → 内联真值从来没更新过，
    # 6081 页面首屏一直显示第一次写入的旧状态。改成任意位置匹配。
    [ "$(grep -m1 -o 'window.__AGH_PRIV={[^}]*}' "$HTML" 2>/dev/null)" = "${_il%;}" ] && return 0
    awk -v new="$_il" '
    BEGIN { BR = sprintf("%c", 125); SC = sprintf("%c", 59) }
    {
        i = index($0, "window.__AGH_PRIV=")
        if (i > 0) {
            s = substr($0, i)
            k = index(s, BR)
            if (k > 0) {
                tail = substr(s, k + 1)
                if (substr(tail, 1, 1) == SC) tail = substr(tail, 2)
                $0 = substr($0, 1, i - 1) new tail
            }
        }
        print
    }' "$HTML" > "$HTML.tmp" 2>/dev/null \
        && mv -f "$HTML.tmp" "$HTML" 2>/dev/null \
        || rm -f "$HTML.tmp" 2>/dev/null
    return 0
}

state_write() {
    # applied 不再硬编码 1：只看 apply() 成功后写的 stamp 在不在。
    # 旧版无论 iptables 是否真的建成链都回 applied:1，页面于是永远显示"已生效"。
    _ap=${_ap:-0}
    [ -f "$STAMP" ] && _ap=1
    _json=$(printf '{"dns":%s,"vpn":%s,"ip":%s,"ntp":%s,"dhcp":%s,"smb":%s,"tcp":%s,"snmp":%s,"applied":%s}' \
        "$DNS" "$VPN" "$IP" "$NTP" "$DHCP" "$SMB" "$TCP" "$SNMP" "$_ap")
    printf '%s\n' "$_json" > "$STATE.tmp" 2>/dev/null && mv -f "$STATE.tmp" "$STATE" 2>/dev/null
    # 连同响应头一起落盘：GET 命中时整个响应只需一次 cat（~20ms）
    { cors; printf '%s\n' "$_json"; } > "$RESP.tmp" 2>/dev/null && mv -f "$RESP.tmp" "$RESP" 2>/dev/null
    inline_write
}

# ---- AGH 原生引擎（safebrowsing / parental）已从隐私页移除 ----
# 这两个开关原来要读 AGH 原生接口拿真值：embed 里只能填 conf 缓存值，
# 而 AGH 引擎的真实状态（AGH 自己也会改）跟缓存值不一致 → 首帧画「已关闭」、
# 异步 GET 回来才翻成「已开启」，就是那一下「关掉又打开」。
# 现在直接删掉这两个开关，页面所有开关的真值都来自本机 conf / iptables，
# 首帧即最终值，不存在翻转。引擎本身在 --apply 里兜底关闭（见 agh_engines_off）。
AGH_API="http://127.0.0.1:40251/control"

# 删掉开关后不能把引擎留在开启态（否则用户再也关不掉它）。
# 幂等：只在本机状态确实为开时才打接口，开机 --apply 时跑一次。
agh_engines_off() {
    [ -x /system/bin/curl ] || command -v curl >/dev/null 2>&1 || return 0
    for _e in safebrowsing parental; do
        _on=$(curl -s -m 2 -u "root:root" "$AGH_API/$_e/status" 2>/dev/null | grep -o '"enabled":true')
        [ -n "$_on" ] && curl -s -o /dev/null -m 2 -u "root:root" -X POST "$AGH_API/$_e/disable" 2>/dev/null
    done
    return 0
}

# 状态缓存：全部来自本机 conf（不再查 AGH，GET 更稳更快）
refresh_state() {
    load_conf
    state_write
}

# mksh 的 printf 不认 `printf -- "..."`（会把 -- 和后续 -A 当选项解析，输出一堆破折号），
# 统一用 %s 垫一步，任何 ROM 的 sh 都吃这一套。
P() { printf '%s\n' "$1"; }

ipt() { iptables -w 2 "$@" 2>/dev/null || iptables "$@" 2>/dev/null; }
ipt6() { ip6tables -w 2 "$@" 2>/dev/null || ip6tables "$@" 2>/dev/null; }

# 原子换链：先把规则灌进 STAGE，再插跳转、摘旧跳转、清旧链、改名收尾
swap_in() { # $1=iptables 函数名
    _f="$1"
    $_f -C OUTPUT -j $STAGE 2>/dev/null || $_f -I OUTPUT 1 -j $STAGE 2>/dev/null
    while $_f -C OUTPUT -j $CHAIN 2>/dev/null; do $_f -D OUTPUT -j $CHAIN 2>/dev/null; done
    $_f -F $CHAIN 2>/dev/null
    $_f -X $CHAIN 2>/dev/null
    $_f -E $STAGE $CHAIN 2>/dev/null
    $_f -C OUTPUT -j $CHAIN 2>/dev/null || $_f -I OUTPUT 1 -j $CHAIN 2>/dev/null
}

apply() {
    # 规则集只由这 8 个开关决定；未变且链在挂 → 不重建（POST 幂等零成本）
    # rl=规则集版本号：本脚本升级后规则语义变了，但 8 个开关值可能一个没动。
    # 只比开关值会让旧链接着旧规则跑下去（升级完看规则还是老的），所以版本必须进 sig。
    _sig="rl=2 dns=$DNS vpn=$VPN ip=$IP ntp=$NTP dhcp=$DHCP smb=$SMB tcp=$TCP snmp=$SNMP"
    if [ -f "$STAMP" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$_sig" ] \
       && ipt -C OUTPUT -j $CHAIN 2>/dev/null; then
        return 0
    fi

    # 规则一次性灌进暂存链：原来 13 条 `iptables -A` 就是 13 次 fork，
    # 每次都要拿 xtables 锁（锁被守护/AGH 占着时要等 30~100ms），实测 POST 3.0s。
    # 改成「先 -F 暂存链，再用 iptables-restore --noflush 一次灌完」，v4/v6 各一次。
    ipt -F $STAGE 2>/dev/null
    {
        printf '*filter\n:%s - [0:0]\n' "$STAGE"
        P "-A $STAGE -o lo -j RETURN"
        P "-A $STAGE -i lo -j RETURN"
        P "-A $STAGE -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN"
        # 防 DNS 泄露（mDNS / SSDP 探针外发）。137 归 smb 组：否则 smb 关掉后 137 仍被这里挡，
        # 现场表现为"开关关了没变化"，被当成开关失效。
        [ "$DNS" = "1" ] && P "-A $STAGE -p udp -m multiport --dports 5353,1900 -j DROP"
        # 防 VPN/IP 泄露（STUN/TURN 协商）
        if [ "$VPN" = "1" ] || [ "$IP" = "1" ]; then
            P "-A $STAGE -p udp -m multiport --dports 3478,3479,5349,5350 -j DROP"
            P "-A $STAGE -p tcp -m multiport --dports 3478,3479,5349,5350 -j DROP"
        fi
        # Teredo / 6to4 隧道承载（IPv4 承载协议 41）
        [ "$VPN" = "1" ] && P "-A $STAGE -p 41 -j DROP"
        [ "$NTP" = "1" ] && P "-A $STAGE -p udp --dport 123 -j DROP"
        # 只挡"发往别处"的 67 探测，本机 68→67 的续租广播（255.255.255.255）放行，否则会断网
        [ "$DHCP" = "1" ] && P "-A $STAGE -p udp --dport 67 ! -d 255.255.255.255 -j DROP"
        if [ "$SMB" = "1" ]; then
            # NBNS(137) NBDGM(138) LLMNR(5355) WS-Discovery(3702)：设备名/机型/共享名的主要广播暴露面
            P "-A $STAGE -p udp -m multiport --dports 137,138,5355,3702 -j DROP"
            # SMB over NetBIOS(139) 与 SMB direct(445) 只走 TCP；UDP 445 本来就不存在
            P "-A $STAGE -p tcp -m multiport --dports 139,445 -j DROP"
        fi
        [ "$TCP" = "1" ] && P "-A $STAGE -p tcp -m multiport --dports 23,25,110,143 -j DROP"
        if [ "$SNMP" = "1" ]; then
            P "-A $STAGE -p udp -m multiport --dports 161,162 -j DROP"
            P "-A $STAGE -p tcp -m multiport --dports 161,162 -j DROP"
        fi
        printf 'COMMIT\n'
    } | iptables-restore --noflush -w 2 >/dev/null 2>&1
    # restore 不可用时（个别 ROM 没有该 applet）退回逐条：
    if ! ipt -C $STAGE -o lo -j RETURN 2>/dev/null; then
        ipt -N $STAGE 2>/dev/null
        ipt -A $STAGE -o lo -j RETURN 2>/dev/null
        ipt -A $STAGE -i lo -j RETURN 2>/dev/null
        ipt -A $STAGE -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN 2>/dev/null
        [ "$DNS" = "1" ] && ipt -A $STAGE -p udp -m multiport --dports 5353,1900 -j DROP 2>/dev/null
        if [ "$VPN" = "1" ] || [ "$IP" = "1" ]; then
            ipt -A $STAGE -p udp -m multiport --dports 3478,3479,5349,5350 -j DROP 2>/dev/null
            ipt -A $STAGE -p tcp -m multiport --dports 3478,3479,5349,5350 -j DROP 2>/dev/null
        fi
        [ "$VPN" = "1" ] && ipt -A $STAGE -p 41 -j DROP 2>/dev/null
        [ "$NTP" = "1" ] && ipt -A $STAGE -p udp --dport 123 -j DROP 2>/dev/null
        [ "$DHCP" = "1" ] && ipt -A $STAGE -p udp --dport 67 ! -d 255.255.255.255 -j DROP 2>/dev/null
        if [ "$SMB" = "1" ]; then
            ipt -A $STAGE -p udp -m multiport --dports 137,138,5355,3702 -j DROP 2>/dev/null
            ipt -A $STAGE -p tcp -m multiport --dports 139,445 -j DROP 2>/dev/null
        fi
        [ "$TCP" = "1" ] && ipt -A $STAGE -p tcp -m multiport --dports 23,25,110,143 -j DROP 2>/dev/null
        if [ "$SNMP" = "1" ]; then
            ipt -A $STAGE -p udp -m multiport --dports 161,162 -j DROP 2>/dev/null
            ipt -A $STAGE -p tcp -m multiport --dports 161,162 -j DROP 2>/dev/null
        fi
    fi
    swap_in ipt

    # IPv6 面（同样的口径，:137 在 v6 上是 NetBIOS 变体，一并挡）
    ipt6 -F $STAGE 2>/dev/null
    {
        printf '*filter\n:%s - [0:0]\n' "$STAGE"
        P "-A $STAGE -o lo -j RETURN"
        P "-A $STAGE -i lo -j RETURN"
        P "-A $STAGE -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN"
        # v6 没有 NetBIOS，137/139/445 在 v6 面是死规则；真正暴露设备名的是 5353/5355/3702/1900
        [ "$DNS" = "1" ] && P "-A $STAGE -p udp -m multiport --dports 5353,1900 -j DROP"
        if [ "$VPN" = "1" ] || [ "$IP" = "1" ]; then
            P "-A $STAGE -p udp -m multiport --dports 3478,3479,5349,5350 -j DROP"
            P "-A $STAGE -p tcp -m multiport --dports 3478,3479,5349,5350 -j DROP"
        fi
        [ "$VPN" = "1" ] && P "-A $STAGE -p udp --dport 3544 -j DROP"
        [ "$NTP" = "1" ] && P "-A $STAGE -p udp --dport 123 -j DROP"
        # DHCPv6 是 546→547 发往 ff02::1:2；只挡非该组播地址的 547，正常续租不受影响
        [ "$DHCP" = "1" ] && P "-A $STAGE -p udp --dport 547 ! -d ff02::1:2 -j DROP"
        if [ "$SMB" = "1" ]; then
            P "-A $STAGE -p udp -m multiport --dports 5355,3702 -j DROP"
        fi
        [ "$TCP" = "1" ] && P "-A $STAGE -p tcp -m multiport --dports 23,25,110,143 -j DROP"
        if [ "$SNMP" = "1" ]; then
            P "-A $STAGE -p udp -m multiport --dports 161,162 -j DROP"
            P "-A $STAGE -p tcp -m multiport --dports 161,162 -j DROP"
        fi
        printf 'COMMIT\n'
    } | ip6tables-restore --noflush -w 2 >/dev/null 2>&1
    # v6 回退段必须与上面逐条等价：原来这里只补了 lo/ct/dns 三条，restore 一失败 v6 面其余开关全哑
    if ! ipt6 -C $STAGE -o lo -j RETURN 2>/dev/null; then
        ipt6 -N $STAGE 2>/dev/null
        ipt6 -A $STAGE -o lo -j RETURN 2>/dev/null
        ipt6 -A $STAGE -i lo -j RETURN 2>/dev/null
        ipt6 -A $STAGE -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN 2>/dev/null
        [ "$DNS" = "1" ] && ipt6 -A $STAGE -p udp -m multiport --dports 5353,1900 -j DROP 2>/dev/null
        if [ "$VPN" = "1" ] || [ "$IP" = "1" ]; then
            ipt6 -A $STAGE -p udp -m multiport --dports 3478,3479,5349,5350 -j DROP 2>/dev/null
            ipt6 -A $STAGE -p tcp -m multiport --dports 3478,3479,5349,5350 -j DROP 2>/dev/null
        fi
        [ "$VPN" = "1" ] && ipt6 -A $STAGE -p udp --dport 3544 -j DROP 2>/dev/null
        [ "$NTP" = "1" ] && ipt6 -A $STAGE -p udp --dport 123 -j DROP 2>/dev/null
        [ "$DHCP" = "1" ] && ipt6 -A $STAGE -p udp --dport 547 ! -d ff02::1:2 -j DROP 2>/dev/null
        if [ "$SMB" = "1" ]; then
            ipt6 -A $STAGE -p udp -m multiport --dports 5355,3702 -j DROP 2>/dev/null
        fi
        [ "$TCP" = "1" ] && ipt6 -A $STAGE -p tcp -m multiport --dports 23,25,110,143 -j DROP 2>/dev/null
        if [ "$SNMP" = "1" ]; then
            ipt6 -A $STAGE -p udp -m multiport --dports 161,162 -j DROP 2>/dev/null
            ipt6 -A $STAGE -p tcp -m multiport --dports 161,162 -j DROP 2>/dev/null
        fi
    fi
    swap_in ipt6

    # stamp 只在链确实挂上时才写：旧版无条件写，轮到 iptables 建链失败（个别 ROM
    # 没有 iptables-restore、或 xtables 锁被占死）也照样写，页面就一直显示 applied:1
    if ipt -C OUTPUT -j $CHAIN 2>/dev/null; then
        printf '%s' "$_sig" > "$STAMP" 2>/dev/null
    else
        rm -f "$STAMP" 2>/dev/null
    fi
    return 0
}

case "$1" in
    --apply)
        load_conf
        apply
        agh_engines_off   # 开关已删，兜底确保 safebrowsing/parental 引擎不会留在开启态
        refresh_state
        exit 0
        ;;
    --refresh)
        refresh_state
        exit 0
        ;;
esac

# 首屏内联态：privacy.html 在 <head> 里同步引这个（?embed=1），
# 页面第一次渲染就拿真值，不再「先画默认关闭 / 再翻成开启」。
case "$QUERY_STRING" in
    *embed=1*)
        load_conf
        printf 'Content-Type: text/javascript; charset=utf-8\r\n'
        printf 'Cache-Control: no-store, no-cache, must-revalidate\r\n\r\n'
        printf 'window.__AGH_PRIV={"dns":%s,"vpn":%s,"ip":%s,"ntp":%s,"dhcp":%s,"smb":%s,"tcp":%s,"snmp":%s};\n' \
            "$DNS" "$VPN" "$IP" "$NTP" "$DHCP" "$SMB" "$TCP" "$SNMP"
        exit 0
        ;;
esac

# 诊断记录（保留原行为）
case "$QUERY_STRING" in
    *diag=*) echo "$(date +%s) $QUERY_STRING" >> /data/adb/agh/privacy_diag.log 2>/dev/null ;;
esac

case "$REQUEST_METHOD" in
    OPTIONS)
        cors
        ;;
    POST)
        body=""
        if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null; then
            body=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
        fi
        load_conf
        # 一次 tr/sed 全部取值（旧版 10 条管道）
        _pv=$(printf '%s' "$body" | tr '&' '\n' | awk -F= '
            { k=$1; v=$2; if (v=="0"||v=="1") printf "%s=%s\n", toupper(k), v }')
        eval "$_pv" 2>/dev/null
        case "$DNS" in 0|1) ;; *) DNS=1 ;; esac
        case "$VPN" in 0|1) ;; *) VPN=1 ;; esac
        case "$IP"  in 0|1) ;; *) IP=1  ;; esac
        case "$NTP" in 0|1) ;; *) NTP=1 ;; esac
        case "$DHCP" in 0|1) ;; *) DHCP=1 ;; esac
        case "$SMB" in 0|1) ;; *) SMB=1 ;; esac
        case "$TCP" in 0|1) ;; *) TCP=1 ;; esac
        case "$SNMP" in 0|1) ;; *) SNMP=1 ;; esac
        save_conf
        apply
        state_write
        cors
        printf '%s\n' "$_json"
        ;;
    *)
        # GET：只读，绝不动 iptables。
        #
        # 缓存失效旧做法是 `[ "$CONF" -nt "$RESP" ]`（比 mtime），实测有两个洞：
        #   ① 还原备份（cp -p / tar / 恢复出厂脚本）后 conf 的 mtime 不变或更旧
        #      → 判定"没改过" → 缓存永不刷新，页面长期显示旧状态；
        #      （真机上踩到过：privacy.conf 里 smb=1，CGI 一直回 smb:0）
        #   ② 同一秒内先改 conf 再请求（多数 /data 是 1 秒精度）→ 判 false
        # 现在改成拿 conf 现算一遍 JSON，和落盘的 STATE 做**内容比对**，
        # 只有内容完全一致才直接用缓存；否则重写 STATE/RESP 并同步 privacy.html 内联值。
        # 开销：一次 awk + 一次 cat，约 30ms，比 mtime 判断可靠的代价。
        load_conf
        _ap=0
        [ -f "$STAMP" ] && _ap=1
        _json=$(printf '{"dns":%s,"vpn":%s,"ip":%s,"ntp":%s,"dhcp":%s,"smb":%s,"tcp":%s,"snmp":%s,"applied":%s}' \
            "$DNS" "$VPN" "$IP" "$NTP" "$DHCP" "$SMB" "$TCP" "$SNMP" "$_ap")
        case "$QUERY_STRING" in
            *sync=1*) rm -f "$STATE" 2>/dev/null ;;
        esac
        # 缓存就是当前真值时直接输出，只比字符串：read 是内建，不 fork。
        # （旧版 cat/tr 各 fork 一次，2~5ms 也是首屏时间）
        _st=""
        [ -s "$STATE" ] && IFS= read -r _st < "$STATE" 2>/dev/null
        if [ "$_st" = "$_json" ]; then
            :   # 值没变，STATE/RESP 不用重写；内联行在 POST/refresh 时已对齐
        else
            state_write
        fi
        cors
        printf '%s\n' "$_json"
        ;;
esac
