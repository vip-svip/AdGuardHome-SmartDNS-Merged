#!/system/bin/sh
# 隐私页渲染器（CGI）：把 privacy.html 原样吐出来，同时做两件事：
#   1) 把首屏真值那一行换成当前状态（实时读 privacy.conf）；
#   2) 带上 no-store 响应头 —— 静态文件在 busybox httpd 下加不了头，
#      浏览器于是可能一直用旧副本（旧副本里还有 localStorage 快照、还有已删的开关），
#      表现就是「我明明改好了、他还是看到会翻的旧页面」。
#
# 访问入口：/cgi-bin/privacy-page ；静态 /privacy.html 里有一段 <!--SHELL_JUMP-->
# 会把人跳到这个 CGI，所以正常路径永远吃不到缓存。
CONF=/data/adb/agh/privacy.conf
# busybox httpd 跑 CGI 时 $0 不一定是绝对路径，先按固定路径找页面，找不到再退到 $0 推导。
HTML=/data/adb/agh/scripts/webui/privacy.html
[ -f "$HTML" ] || HTML="${0%/*}/../privacy.html"

DNS=1; VPN=1; IP=1; NTP=1; DHCP=1; SMB=1; TCP=1; SNMP=1
if [ -f "$CONF" ]; then
    _kv=$(awk -F= '
        {
            k = $1; v = $2
            gsub(/[ \t\r]/, "", k); gsub(/[ \t\r]/, "", v)
            sub(/[#;].*/, "", v)
            if (v == "0" || v == "1") printf "%s=%s\n", toupper(k), v
        }' "$CONF" 2>/dev/null)
    eval "$_kv" 2>/dev/null
fi
for _k in DNS VPN IP NTP DHCP SMB TCP SNMP; do
    eval "_v=\$$_k; case \"\$_v\" in 0|1) ;; *) eval \"$_k=1\" ;; esac"
done

_il=$(printf 'window.__AGH_PRIV={"dns":%s,"vpn":%s,"ip":%s,"ntp":%s,"dhcp":%s,"smb":%s,"tcp":%s,"snmp":%s};' \
    "$DNS" "$VPN" "$IP" "$NTP" "$DHCP" "$SMB" "$TCP" "$SNMP")

printf 'Content-Type: text/html; charset=utf-8\r\n'
printf 'Cache-Control: no-store, no-cache, must-revalidate, max-age=0\r\n'
printf 'Pragma: no-cache\r\n'
printf 'Expires: 0\r\n\r\n'

[ -f "$HTML" ] || { printf '<h1>privacy.html missing</h1>\n'; exit 0; }

awk -v line="$_il" '
    /^<!--SHELL_JUMP-->/ { skip = 1; next }
    /^<!--\/SHELL_JUMP-->/ { skip = 0; next }
    skip { next }
    /^window\.__AGH_PRIV=/ { print line; next }
    { print }
' "$HTML" 2>/dev/null
