#!/system/bin/sh
# 重写脚本 CGI —— 对齐「过滤器—拦截列表」的能力
#   GET  /cgi-bin/scripts                 列表（名称/格式/域名/规则数/大小/时间/启用）
#   GET  ?apply=1                         汇总已启用脚本的 reject 域名 -> AGH 过滤器
#   GET  ?toggle=NAME                     启用/停用
#   GET  ?read=NAME                       读取脚本全文（本地查看/编辑）
#   GET  ?catalog=1                       内置脚本清单（从列表添加用）
#   GET  ?addcat=KIND/FILE                从内置清单添加一个脚本
#   GET  ?addurl=NAME&url=URL             从远程地址下载脚本
#   POST ?save=NAME  body=<内容>          保存（新建或覆盖编辑）
#   POST ?upload=NAME body=<内容>         上传本地文件
#   GET  ?del=NAME                        删除
#
# 支持格式：.plugin/.lpx(Loon) .sgmodule(Surge) .conf(小火箭/QX) .rewrite .js
#           .yaml/.json(Clash/sing-box) .list/.txt/.hosts/.module
DIR=/data/adb/agh/scripts/rewrite
OUT=/data/adb/modules/AdGuardHome/rules/脚本拦截.txt
CAT=/data/adb/modules/AdGuardHome/scripts/catalog
AGH=http://127.0.0.1:40251
LOGIN=root:root

cors() {
    printf 'Cache-Control: no-store, no-cache, must-revalidate\r\n'
    printf 'Access-Control-Allow-Origin: *\r\n'
    printf 'Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n'
    printf 'Access-Control-Allow-Headers: *\r\n'
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf '\r\n'
}
json_escape() { printf '%s' "$1" | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

[ -d "$DIR" ] || mkdir -p "$DIR" 2>/dev/null

# ---- 列表快照缓存 ----
# 列表 CGI 对每个脚本要跑 fmt_of/domains_of/count_reject/date/wc 十余条管道，
# 冷算一次实测 0.9s；前端在拿到响应前会先渲染空态（「这里还没有脚本」）→ 刷新闪烁。
# 现在按「目录内容签名」缓存整段 JSON，签名没变就直接吐快照（毫秒级）。
LIST_SNAP=/data/adb/agh/.scripts_list.json
LIST_SIG=/data/adb/agh/.scripts_list.sig
LIST_RESP=/data/adb/agh/.scripts_list.resp
dir_sig() {
    stat -c '%n %s %Y' "$DIR"/* "$DIR"/js/*.js "$DIR"/.*.off 2>/dev/null
}

# 列表响应（含响应头）整体缓存：GET 命中时只有一次 cat，
# 把冷算的 0.9s 降到 ~20ms，前端来不及渲染「这里还没有脚本」空态。
build_list() {
    {
        printf 'Cache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n'
        printf 'Content-Type: application/json; charset=utf-8\r\n\r\n'
        printf '{"dir":"%s","out":"%s","catalog":"%s","js_total":%s,"scripts":[' "$DIR" "$OUT" "$CAT" "$(js_count)"
        _first=1
        for f in "$DIR"/*; do
            [ -f "$f" ] || continue
            b=${f##*/}
            case "$b" in .*) continue ;; esac
            typ=$(fmt_of "$b")
            sz=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
            mt=$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)
            dn=$(domains_of "$b" | tr -d ' ' | tr 'A-Z' 'a-z' | sed 's/^\*\.//' | grep -E '^[a-z0-9]' | sort -u | wc -l | tr -d ' ')
            rj=$(count_reject "$b")
            en=$(enabled "$b")
            if [ $_first -eq 1 ]; then _first=0; else printf ','; fi
            printf '{"name":"%s","type":"%s","size":%s,"mtime":"%s","domains":%s,"reject_rules":%s,"enabled":%s}' \
                "$(json_escape "$b")" "$typ" "${sz:-0}" "${mt:-}" "${dn:-0}" "${rj:-0}" "$en"
        done
        printf ']}\n'
    } > "$LIST_RESP.tmp" 2>/dev/null
    if [ -s "$LIST_RESP.tmp" ]; then
        mv -f "$LIST_RESP.tmp" "$LIST_RESP" 2>/dev/null
        dir_sig > "$LIST_SIG" 2>/dev/null
    else
        rm -f "$LIST_RESP.tmp" 2>/dev/null
    fi
}

enabled() { [ -f "$DIR/.$1.off" ] && echo 0 || echo 1; }

fmt_of() {
    _n="$1"; _e="${_n##*.}"
    case "$_e" in
        plugin|lpx|module) echo "Loon 插件" ;;
        sgmodule)   echo "Surge 模块" ;;
        conf)       if grep -q '^\[rewrite_local\]' "$DIR/$_n" 2>/dev/null; then echo "Quantumult X 配置"
                    elif grep -q '^\[URL Rewrite\]' "$DIR/$_n" 2>/dev/null; then echo "小火箭/Surge 配置"
                    else echo "代理配置"; fi ;;
        rewrite)    echo "小火箭/Surge 重写" ;;
        js)         echo "JS 脚本" ;;
        yaml|yml)   echo "Clash 规则" ;;
        json)       echo "JSON 规则" ;;
        hosts)      echo "hosts" ;;
        list)       echo "规则列表" ;;
        txt)        echo "文本规则" ;;
        *)          echo "其它" ;;
    esac
}

domains_of() {
    _f="$DIR/$1"
    grep -iE 'url[ -]reject|reject-(200|img|dict|array)' "$_f" 2>/dev/null \
        | grep -oE 'http[a-z?]*://[^/ ]+' \
        | sed -e 's#^http[a-z?]*://##' -e 's/^\.\*\.//' -e 's/^\*\.//' -e 's/\\\././g' -e 's/^\.//'
    grep -iE ',\s*(REJECT|REJECT-TINYGIF|REJECT-DROP|REJECT-NO-DROP)\s*$' "$_f" 2>/dev/null \
        | awk -F, '{h=$2; gsub(/ /,"",h); print h}'
    grep -iE '^[[:space:]]*(DOMAIN-SUFFIX|DOMAIN|HOST-SUFFIX|HOST|HOST-KEYWORD)' "$_f" 2>/dev/null \
        | awk -F, '{h=$2; gsub(/ /,"",h); print h}'
    awk 'tolower($1) ~ /^hostname/' "$_f" 2>/dev/null | sed 's/.*=//' | sed 's/%APPEND%//g' | tr ',' '\n' | tr -d ' '
    grep -iE '^[[:space:]]*address=/' "$_f" 2>/dev/null | sed 's#.*/\([^/]*\)/.*#\1#'
    awk '($1=="0.0.0.0"||$1=="127.0.0.1"||$1=="::1"||$1=="::"||$1=="::0"){print $2}' "$_f" 2>/dev/null
    grep -oE '"(domain|domain_suffix|domain_keyword)"\s*:\s*\[[^]]*\]' "$_f" 2>/dev/null \
        | grep -oE '"[a-zA-Z0-9*._-]+\.[a-zA-Z0-9._-]+"' | tr -d '"'
    grep -oE "DOMAIN(-SUFFIX|-KEYWORD)?,[^,']+" "$_f" 2>/dev/null | cut -d, -f2
    grep -oE '^\|\|[a-zA-Z0-9*._-]+\^?$' "$_f" 2>/dev/null | tr -d '|^'
    grep -oE '^(\*\.)?[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)+$' "$_f" 2>/dev/null
}

count_reject() { grep -icE 'reject|url[ -]reject|address=/' "$DIR/$1" 2>/dev/null; }

# 模块/插件里 [Script] 段用 script-path 引用的 JS 要落到 js/ 子目录，
# aghmitm 才会加载并按模块里的 URL 正则执行。
fetch_js() {
    _jf="$DIR/$1"
    [ -f "$_jf" ] || return 0
    case "$1" in
        *.module|*.plugin|*.lpx|*.sgmodule|*.conf) : ;;
        *) return 0 ;;
    esac
    mkdir -p "$DIR/js" 2>/dev/null
    _lst=/data/adb/agh/.jsrefs
    : > "$_lst" 2>/dev/null
    grep -oE 'script-path[[:space:]]*=[[:space:]]*[^,[:space:]]+' "$_jf" 2>/dev/null | sed 's/.*=[[:space:]]*//' >> "$_lst"
    grep -oE 'https?://[^,[:space:]]+\.js' "$_jf" 2>/dev/null >> "$_lst"
    sort -u "$_lst" 2>/dev/null | while read -r _u; do
        [ -n "$_u" ] || continue
        _jb="${_u##*/}"
        case "$_jb" in ""|*..*|*/*) continue ;; esac
        [ -s "$DIR/js/$_jb" ] && continue
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL --max-time 25 -A "Mozilla/5.0" "$_u" -o "$DIR/js/$_jb" 2>/dev/null
        elif command -v wget >/dev/null 2>&1; then
            wget -q -T 25 -U "Mozilla/5.0" -O "$DIR/js/$_jb" "$_u" 2>/dev/null
        fi
        if [ -s "$DIR/js/$_jb" ]; then chmod 644 "$DIR/js/$_jb" 2>/dev/null
        else rm -f "$DIR/js/$_jb" 2>/dev/null; fi
    done
    rm -f "$_lst" 2>/dev/null
    reload_mitm
}

# MITM 在跑时重启一次，让新加的 JS 立刻生效（不在跑就不动）
reload_mitm() {
    [ -f /data/adb/agh/mitm_on ] || return 0
    pidof aghmitm >/dev/null 2>&1 || return 0
    pidof aghmitm | xargs -r kill 2>/dev/null
    sleep 1
    # AGH 运行配置在 /data/adb/agh/bin/，modules/ 下那份只是模板（端口可能已漂移）
    _dp=$(awk '/^dns:/{f=1} f&&/^[[:space:]]+port:/{print $2; exit}' /data/adb/agh/bin/AdGuardHome.yaml 2>/dev/null)
    case "$_dp" in ''|*[!0-9]*)
        _dp=$(netstat -tlnup 2>/dev/null | grep AdGuardHome | grep udp | sed -n 's/.*[:.]\([0-9]*\) .*/\1/p' | head -1) ;;
    esac
    case "$_dp" in ''|*[!0-9]*)
        _dp=$(grep -oE '^redir_port=[0-9]+' /data/adb/agh/scripts/config.prop 2>/dev/null | cut -d= -f2) ;;
    esac
    setsid /data/adb/modules/AdGuardHome/bin/aghmitm -listen 127.0.0.1:8899 \
        -rules /data/adb/agh/scripts/rewrite -dns "127.0.0.1:${_dp:-5591}" \
        >>/data/adb/agh/mitm.log 2>&1 &
}

js_count() {
    _jc=0
    for _f in "$DIR"/*.js "$DIR"/js/*.js; do
        [ -f "$_f" ] && _jc=$((_jc + 1))
    done
    echo "$_jc"
}

clean_name() {
    _n=$(printf '%s' "$1" | sed 's/+/ /g')
    case "$_n" in ""|*/*|*..*|.*) echo ""; return ;; esac
    case "$_n" in
        *.rewrite|*.plugin|*.lpx|*.sgmodule|*.module|*.conf|*.js|*.yaml|*.yml|*.json|*.list|*.txt|*.hosts) ;;
        *) _n="$_n.rewrite" ;;
    esac
    echo "$_n"
}

do_apply() {
    _ap_tmp=/data/adb/agh/.rwtmp
    : > "$_ap_tmp"
    for _ap_f in "$DIR"/*; do
        [ -f "$_ap_f" ] || continue
        _ap_b=$(basename "$_ap_f")
        case "$_ap_b" in .*) continue ;; esac
        [ -f "$DIR/.$_ap_b.off" ] && continue
        domains_of "$_ap_b" >> "$_ap_tmp"
    done
    sed -i 's/^[[:space:]]*//; s/[[:space:]]*$//' "$_ap_tmp" 2>/dev/null
    tr -d ' ' < "$_ap_tmp" | tr 'A-Z' 'a-z' | sed 's/^\*\.//' | grep -E '^[a-z0-9]' | grep -v '^localhost$' | sort -u > "$_ap_tmp.u"
    _ap_cnt=$(wc -l < "$_ap_tmp.u" 2>/dev/null | tr -d ' ')
    if [ "${_ap_cnt:-0}" -lt 1 ]; then
        rm -f "$_ap_tmp" "$_ap_tmp.u"; : > "$OUT"
        cors; printf '{"ok":true,"applied":0,"note":"已启用的脚本里没有 reject 规则"}\n'; return
    fi
    { echo '! 由脚本页汇总：小火箭/Loon/Surge/QX/Clash/sing-box/V2Ray/hosts/dnsmasq'; sed 's/^/||/; s/$/^/' "$_ap_tmp.u"; } > "$OUT"
    rm -f "$_ap_tmp" "$_ap_tmp.u"
    curl -s -u "$LOGIN" -H 'Content-Type: application/json' \
        -d '{"data":{"name":"脚本拦截","url":"/data/adb/modules/AdGuardHome/rules/脚本拦截.txt","enabled":true},"url":"/data/adb/modules/AdGuardHome/rules/脚本拦截.txt","whitelist":false}' \
        "$AGH/control/filtering/add_url" >/dev/null 2>&1
    _ap_ids=$(curl -s -u "$LOGIN" "$AGH/control/filtering/status" 2>/dev/null | tr ',' '\n' | awk -F: '/"id"/{gsub(/[^0-9]/,"",$2); printf "%s,",$2}' | sed 's/,$//')
    [ -n "$_ap_ids" ] && curl -s -u "$LOGIN" -H 'Content-Type: application/json' -d "{\"ids\":[$_ap_ids]}" "$AGH/control/filtering/refresh" >/dev/null 2>&1
    cors; printf '{"ok":true,"applied":%s,"file":"%s"}\n' "$_ap_cnt" "$OUT"
}
do_apply_list() { do_apply "$@" >/dev/null 2>&1; build_list; }
write_body() {
    _name=$(clean_name "$1")
    [ -n "$_name" ] || { cors; printf '{"ok":false,"error":"bad name"}\n'; return; }
    _len=${CONTENT_LENGTH:-0}
    if [ "${_len:-0}" -gt 0 ] 2>/dev/null; then
        mkdir -p "$DIR" 2>/dev/null
        dd bs=1 count="$_len" 2>/dev/null > "$DIR/$_name"
    else
        cat > "$DIR/$_name"
    fi
    chmod 644 "$DIR/$_name" 2>/dev/null
    rm -f "$DIR/.$_name.off" 2>/dev/null
    fetch_js "$_name"
    _sz=$(wc -c < "$DIR/$_name" 2>/dev/null | tr -d ' ')
    do_apply_list
    cors; printf '{"ok":true,"name":"%s","size":%s,"js":%s}\n' "$(json_escape "$_name")" "${_sz:-0}" "$(js_count)"
}

case "$REQUEST_METHOD" in
    OPTIONS) cors; exit 0 ;;
    POST)
        _tgt=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*save=\([^&]*\).*/\1/p')
        [ -n "$_tgt" ] || _tgt=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*upload=\([^&]*\).*/\1/p')
        write_body "$_tgt"
        exit 0
        ;;
esac

Q="$QUERY_STRING"
case "$Q" in
    *addurl=*)
        # 远程下载：?addurl=NAME&url=ENCODED_URL
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^addurl=//p' | head -1 | sed 's/%20/ /g')
        _u=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^url=//p' | head -1 | sed 's/%3A/:/g; s/%2F/\//g; s/%3F/?/g; s/%3D/=/g; s/%26/\&/g; s/%25/%/g; s/+/ /g')
        case "$_n" in ""|*/*|*..*) cors; printf '{"ok":false,"error":"bad name"}\n'; exit 0 ;; esac
        case "$_u" in http*://*) : ;; *) cors; printf '{"ok":false,"error":"bad url"}\n'; exit 0 ;; esac
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL --max-time 30 -A "Mozilla/5.0" "$_u" -o "$DIR/$_n" 2>/dev/null
        elif command -v wget >/dev/null 2>&1; then
            wget -q -T 30 -U "Mozilla/5.0" -O "$DIR/$_n" "$_u" 2>/dev/null
        fi
        if [ -s "$DIR/$_n" ]; then
            chmod 644 "$DIR/$_n" 2>/dev/null
            rm -f "$DIR/.$_n.off" 2>/dev/null
            fetch_js "$_n"
            _sz=$(wc -c < "$DIR/$_n" 2>/dev/null | tr -d ' ')
            do_apply_list
            cors; printf '{"ok":true,"name":"%s","size":%s,"js":%s}\n' "$(json_escape "$_n")" "${_sz:-0}" "$(js_count)"
        else
            rm -f "$DIR/$_n" 2>/dev/null
            cors; printf '{"ok":false,"error":"下载失败"}\n'
        fi
        exit 0
        ;;
    *apply=*)  do_apply; build_list; exit 0 ;;
    *catalog=*)
        cors
        _idx="$CAT/index.json"
        if [ -f "$_idx" ]; then
            printf '{"ok":true,"index":"%s","scripts":' "$_idx"
            sed '1s/^.*\[/[/' < "$_idx"
            printf '}\n'
        else
            printf '{"ok":false,"error":"index.json 缺失","scripts":[]}\n'
        fi
        exit 0
        ;;    *addcat=*)
        _rel=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^addcat=//p' | head -1 | sed 's/%2F/\//g; s/%20/ /g')
        case "$_rel" in ""|*..*) cors; printf '{"ok":false,"error":"bad path"}\n'; exit 0 ;; esac
        _idx="$CAT/index.json"
        # index.json 里按 path 找到 url（path 形如 kind/file）
        _url=$(tr ',' '\n' < "$_idx" 2>/dev/null | awk -v p="\"path\":\"$_rel\"" 'index($0,p){print; exit}' | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
        [ -n "$_url" ] || _url=$(tr '{' '\n' < "$_idx" 2>/dev/null | awk -v p="\"path\":\"$_rel\"" 'index($0,p){print; exit}' | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
        _base=$(basename "$_rel")
        # 优先用模块内置副本（离线可用），没有再联网拉取
        if [ -s "$CAT/$_rel" ]; then
            cp -f "$CAT/$_rel" "$DIR/$_base" 2>/dev/null
        elif [ -n "$_url" ] && command -v curl >/dev/null 2>&1; then
            curl -fsSL --max-time 25 -A "Mozilla/5.0" "$_url" -o "$DIR/$_base" 2>/dev/null
        fi
        if [ -s "$DIR/$_base" ]; then
            chmod 644 "$DIR/$_base" 2>/dev/null
            rm -f "$DIR/.$_base.off" 2>/dev/null
            fetch_js "$_base"
            do_apply_list
            cors; printf '{"ok":true,"name":"%s","js":%s}\n' "$(json_escape "$_base")" "$(js_count)"
        else
            rm -f "$DIR/$_base" 2>/dev/null
            cors; printf '{"ok":false,"error":"下载失败"}\n'
        fi
        exit 0
        ;;
    *view=*)
        # 本地查看：与拦截列表 view_file 同款 —— 先拉起本地应用打开真实路径
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^view=//p' | head -1 | sed 's/%20/ /g')
        case "$_n" in ""|*/*|*..*) cors; printf '{"ok":false,"error":"bad name"}\n'; exit 0 ;; esac
        _p="$DIR/$_n"
        [ -f "$_p" ] || { cors; printf '{"ok":false,"error":"not found"}\n'; exit 0; }
        _sz=$(wc -c < "$_p" 2>/dev/null | tr -d ' ')
        _ok=0
        for _c in "bin.mt.plus/.OpenTextActivity" "bin.mt.plus/.OpenFileActivity"; do
            _out=$(/system/bin/am start -a android.intent.action.VIEW -d "file://$_p" -t text/plain -n "$_c" 2>&1)
            case "$_out" in *Error*) : ;; *) [ -n "$_out" ] && _ok=1 && break ;; esac
        done
        if [ "$_ok" -eq 0 ]; then
            _out=$(/system/bin/am start -a android.intent.action.VIEW -d "file://$_p" -t text/plain 2>&1)
            case "$_out" in *Error*) : ;; *) [ -n "$_out" ] && _ok=1 ;; esac
        fi
        if [ "$_ok" -eq 1 ]; then
            cors; printf '{"ok":true,"path":"%s","size":%s}\n' "$(json_escape "$_p")" "${_sz:-0}"
        else
            cors; printf '{"ok":false,"error":"no viewer"}\n'
        fi
        exit 0
        ;;
    *view_raw=*)
        # 浏览器渲染兜底：与拦截列表 view_file_raw 同款独立页（路径+字节数+全文）
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^view_raw=//p' | head -1 | sed 's/%20/ /g')
        case "$_n" in ""|*/*|*..*) printf 'Content-Type: text/plain; charset=utf-8\r\n\r\nbad name\n'; exit 0 ;; esac
        _p="$DIR/$_n"
        [ -f "$_p" ] || { printf 'Content-Type: text/plain; charset=utf-8\r\n\r\nnot found\n'; exit 0; }
        _sz=$(wc -c < "$_p" 2>/dev/null | tr -d ' ')
        _hesc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
        printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store, no-cache, must-revalidate\r\nAccess-Control-Allow-Origin: *\r\n\r\n'
        printf '<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>%s</title><style>:root{color-scheme:light dark}body{margin:0;padding:0;font:14px/1.5 -apple-system,"Segoe UI",Roboto,sans-serif;background:#f6f7f9;color:#111}header{position:sticky;top:0;background:#fff;border-bottom:1px solid #e3e6ea;padding:10px 14px}h1{font-size:14px;margin:0 0 4px;font-weight:600}.p{font:12px/1.4 ui-monospace,Menlo,Consolas,monospace;color:#4a5560;word-break:break-all}.m{font-size:12px;color:#8b95a1;margin-top:4px}pre{margin:0;padding:14px;white-space:pre-wrap;word-break:break-all;font:12.5px/1.6 ui-monospace,Menlo,Consolas,monospace;background:#fff}@media(prefers-color-scheme:dark){body{background:#16181c;color:#e6e8eb}header{background:#1e2126;border-color:#2c3138}pre{background:#1e2126}.p{color:#a8b2bd}.m{color:#7c8794}}</style></head><body><header><h1>%s</h1><div class="p">%s</div><div class="m">%s 字节 · 直接编辑该文件即可生效</div></header><pre>' \
            "$(_hesc "$_n")" "$(_hesc "$_n")" "$(_hesc "$_p")" "${_sz:-0}"
        sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' < "$_p"
        printf '</pre></body></html>\n'
        exit 0
        ;;
    *read=*)
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^read=//p' | head -1 | sed 's/%20/ /g')
        case "$_n" in ""|*/*|*..*) printf 'Content-Type: text/plain; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\n\r\n'; exit 0 ;; esac
        printf 'Content-Type: text/plain; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\n\r\n'
        [ -f "$DIR/$_n" ] && cat "$DIR/$_n"
        exit 0
        ;;
    *toggle=*)
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^toggle=//p' | head -1 | sed 's/%20/ /g')
        case "$_n" in ""|*/*|*..*) cors; printf '{"ok":false,"error":"bad name"}\n'; exit 0 ;; esac
        [ -f "$DIR/$_n" ] || { cors; printf '{"ok":false,"error":"not found"}\n'; exit 0; }
        if [ -f "$DIR/.$_n.off" ]; then rm -f "$DIR/.$_n.off"; _st=1; else : > "$DIR/.$_n.off"; _st=0; fi
        build_list
        cors; printf '{"ok":true,"name":"%s","enabled":%s}\n' "$(json_escape "$_n")" "$_st"
        exit 0
        ;;
    *del=*)
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^del=//p' | head -1 | sed 's/%20/ /g')
        case "$_n" in ""|*/*|*..*|.*) cors; printf '{"ok":false,"error":"bad name"}\n'; exit 0 ;; esac
        if [ -f "$DIR/$_n" ]; then
            rm -f "$DIR/$_n" "$DIR/.$_n.off" 2>/dev/null
            do_apply_list
            cors; printf '{"ok":true,"deleted":"%s"}\n' "$(json_escape "$_n")"
        else
            cors; printf '{"ok":false,"error":"not found"}\n'
        fi
        exit 0
        ;;
esac

# GET 列表：命中缓存就是一次 cat（~20ms）；?rebuild=1 强制重算
case "$QUERY_STRING" in
    *rebuild=*) rm -f "$LIST_RESP" ;;
esac
# 目录/文件比缓存新（新增、删除、外部编辑）就重建。-nt 是 shell 内建，不 fork。
if [ -s "$LIST_RESP" ]; then
    [ "$DIR" -nt "$LIST_RESP" ] && rm -f "$LIST_RESP"
    for _f in "$DIR"/* "$DIR"/js/*.js "$DIR"/.*.off; do
        [ -f "$_f" ] && [ "$_f" -nt "$LIST_RESP" ] && { rm -f "$LIST_RESP"; break; }
    done
fi
if [ -s "$LIST_RESP" ]; then
    cat "$LIST_RESP" 2>/dev/null
else
    build_list
    if [ -s "$LIST_RESP" ]; then
        cat "$LIST_RESP" 2>/dev/null
    else
        cors
        printf '{"dir":"%s","out":"%s","catalog":"%s","js_total":0,"scripts":[]}\n' "$DIR" "$OUT" "$CAT"
    fi
fi
