#!/system/bin/sh
# 重写脚本 CGI —— 对齐「过滤器—拦截列表」的能力
#   GET  /cgi-bin/scripts                 列表（名称/格式/域名/规则数/大小/时间/启用）
#   GET  ?apply=1                         汇总已启用脚本的 reject 域名 -> AGH 过滤器
#   GET  ?toggle=NAME                     启用/停用
#   GET  ?read=NAME                       读取脚本全文（本地查看/编辑）
#   GET  ?catalog=1                       内置脚本清单（从列表添加用）
#   GET  ?addcat=KIND/FILE                从内置清单添加一个脚本
#   POST ?save=NAME  body=<内容>          保存（新建或覆盖编辑）
#   POST ?upload=NAME body=<内容>         上传本地文件
#   GET  ?del=NAME                        删除
#
# 支持格式：.plugin/.lpx(Loon) .sgmodule(Surge) .conf(小火箭/QX) .rewrite .js
#           .yaml/.json(Clash/sing-box) .list/.txt/.hosts/.module
DIR=/data/adb/agh/scripts/rewrite
OUT=/data/adb/modules/AdGuardHome/rules/脚本拦截.txt
CAT=/data/adb/modules/AdGuardHome/scripts/catalog
AGH=http://127.0.0.1:40251
LOGIN=root:root

cors() {
    printf 'Access-Control-Allow-Origin: *\r\n'
    printf 'Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n'
    printf 'Access-Control-Allow-Headers: *\r\n'
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf '\r\n'
}
json_escape() { printf '%s' "$1" | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

mkdir -p "$DIR" 2>/dev/null

enabled() { [ -f "$DIR/.$1.off" ] && echo 0 || echo 1; }

fmt_of() {
    _n="$1"; _e="${_n##*.}"
    case "$_e" in
        plugin|lpx|module) echo "Loon 插件" ;;
        sgmodule)   echo "Surge 模块" ;;
        conf)       if grep -q '^\[rewrite_local\]' "$DIR/$_n" 2>/dev/null; then echo "Quantumult X 配置"
                    elif grep -q '^\[URL Rewrite\]' "$DIR/$_n" 2>/dev/null; then echo "小火箭/Surge 配置"
                    else echo "代理配置"; fi ;;
        rewrite)    echo "小火箭/Surge 重写" ;;
        js)         echo "JS 脚本" ;;
        yaml|yml)   echo "Clash 规则" ;;
        json)       echo "JSON 规则" ;;
        hosts)      echo "hosts" ;;
        list)       echo "规则列表" ;;
        txt)        echo "文本规则" ;;
        *)          echo "其它" ;;
    esac
}

domains_of() {
    _f="$DIR/$1"
    grep -iE 'url[ -]reject|reject-(200|img|dict|array)' "$_f" 2>/dev/null \
        | grep -oE 'http[a-z?]*://[^/ ]+' \
        | sed -e 's#^http[a-z?]*://##' -e 's/^\.\*\.//' -e 's/^\*\.//' -e 's/\\\././g' -e 's/^\.//'
    grep -iE ',\s*(REJECT|REJECT-TINYGIF|REJECT-DROP|REJECT-NO-DROP)\s*$' "$_f" 2>/dev/null \
        | awk -F, '{h=$2; gsub(/ /,"",h); print h}'
    grep -iE '^[[:space:]]*(DOMAIN-SUFFIX|DOMAIN|HOST-SUFFIX|HOST|HOST-KEYWORD)' "$_f" 2>/dev/null \
        | awk -F, '{h=$2; gsub(/ /,"",h); print h}'
    awk 'tolower($1) ~ /^hostname/' "$_f" 2>/dev/null | sed 's/.*=//' | sed 's/%APPEND%//g' | tr ',' '\n' | tr -d ' '
    grep -iE '^[[:space:]]*address=/' "$_f" 2>/dev/null | sed 's#.*/\([^/]*\)/.*#\1#'
    awk '($1=="0.0.0.0"||$1=="127.0.0.1"||$1=="::1"||$1=="::"||$1=="::0"){print $2}' "$_f" 2>/dev/null
    grep -oE '"(domain|domain_suffix|domain_keyword)"\s*:\s*\[[^]]*\]' "$_f" 2>/dev/null \
        | grep -oE '"[a-zA-Z0-9*._-]+\.[a-zA-Z0-9._-]+"' | tr -d '"'
    grep -oE "DOMAIN(-SUFFIX|-KEYWORD)?,[^,']+" "$_f" 2>/dev/null | cut -d, -f2
    grep -oE '^\|\|[a-zA-Z0-9*._-]+\^?$' "$_f" 2>/dev/null | tr -d '|^'
    grep -oE '^(\*\.)?[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)+$' "$_f" 2>/dev/null
}

count_reject() { grep -icE 'reject|url[ -]reject|address=/' "$DIR/$1" 2>/dev/null; }

clean_name() {
    _n=$(printf '%s' "$1" | sed 's/+/ /g')
    case "$_n" in ""|*/*|*..*|.*) echo ""; return ;; esac
    case "$_n" in
        *.rewrite|*.plugin|*.lpx|*.sgmodule|*.module|*.conf|*.js|*.yaml|*.yml|*.json|*.list|*.txt|*.hosts) ;;
        *) _n="$_n.rewrite" ;;
    esac
    echo "$_n"
}

do_apply() {
    _ap_tmp=/data/adb/agh/.rwtmp
    : > "$_ap_tmp"
    for _ap_f in "$DIR"/*; do
        [ -f "$_ap_f" ] || continue
        _ap_b=$(basename "$_ap_f")
        case "$_ap_b" in .*) continue ;; esac
        [ -f "$DIR/.$_ap_b.off" ] && continue
        domains_of "$_ap_b" >> "$_ap_tmp"
    done
    sed -i 's/^[[:space:]]*//; s/[[:space:]]*$//' "$_ap_tmp" 2>/dev/null
    tr -d ' ' < "$_ap_tmp" | tr 'A-Z' 'a-z' | sed 's/^\*\.//' | grep -E '^[a-z0-9]' | grep -v '^localhost$' | sort -u > "$_ap_tmp.u"
    _ap_cnt=$(wc -l < "$_ap_tmp.u" 2>/dev/null | tr -d ' ')
    if [ "${_ap_cnt:-0}" -lt 1 ]; then
        rm -f "$_ap_tmp" "$_ap_tmp.u"; : > "$OUT"
        cors; printf '{"ok":true,"applied":0,"note":"已启用的脚本里没有 reject 规则"}\n'; return
    fi
    { echo '! 由脚本页汇总：小火箭/Loon/Surge/QX/Clash/sing-box/V2Ray/hosts/dnsmasq'; sed 's/^/||/; s/$/^/' "$_ap_tmp.u"; } > "$OUT"
    rm -f "$_ap_tmp" "$_ap_tmp.u"
    curl -s -u "$LOGIN" -H 'Content-Type: application/json' \
        -d '{"data":{"name":"脚本拦截","url":"/data/adb/modules/AdGuardHome/rules/脚本拦截.txt","enabled":true},"url":"/data/adb/modules/AdGuardHome/rules/脚本拦截.txt","whitelist":false}' \
        "$AGH/control/filtering/add_url" >/dev/null 2>&1
    _ap_ids=$(curl -s -u "$LOGIN" "$AGH/control/filtering/status" 2>/dev/null | tr ',' '\n' | awk -F: '/"id"/{gsub(/[^0-9]/,"",$2); printf "%s,",$2}' | sed 's/,$//')
    [ -n "$_ap_ids" ] && curl -s -u "$LOGIN" -H 'Content-Type: application/json' -d "{\"ids\":[$_ap_ids]}" "$AGH/control/filtering/refresh" >/dev/null 2>&1
    cors; printf '{"ok":true,"applied":%s,"file":"%s"}\n' "$_ap_cnt" "$OUT"
}
write_body() {
    _name=$(clean_name "$1")
    [ -n "$_name" ] || { cors; printf '{"ok":false,"error":"bad name"}\n'; return; }
    _len=${CONTENT_LENGTH:-0}
    if [ "${_len:-0}" -gt 0 ] 2>/dev/null; then
        mkdir -p "$DIR" 2>/dev/null
        dd bs=1 count="$_len" 2>/dev/null > "$DIR/$_name"
    else
        cat > "$DIR/$_name"
    fi
    chmod 644 "$DIR/$_name" 2>/dev/null
    rm -f "$DIR/.$_name.off" 2>/dev/null
    _sz=$(wc -c < "$DIR/$_name" 2>/dev/null | tr -d ' ')
    do_apply >/dev/null 2>&1
    cors; printf '{"ok":true,"name":"%s","size":%s}\n' "$_name" "${_sz:-0}"
}

case "$REQUEST_METHOD" in
    OPTIONS) cors; exit 0 ;;
    POST)
        _tgt=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*save=\([^&]*\).*/\1/p')
        [ -n "$_tgt" ] || _tgt=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*upload=\([^&]*\).*/\1/p')
        write_body "$_tgt"
        exit 0
        ;;
esac

Q="$QUERY_STRING"
case "$Q" in
    *apply=*)  do_apply; exit 0 ;;
    *catalog=*)
        cors
        _idx="$CAT/index.json"
        if [ -f "$_idx" ]; then
            printf '{"ok":true,"index":"%s","scripts":' "$_idx"
            sed '1s/^.*\[/[/' < "$_idx"
            printf '}\n'
        else
            printf '{"ok":false,"error":"index.json 缺失","scripts":[]}\n'
        fi
        exit 0
        ;;    *addcat=*)
        _rel=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^addcat=//p' | head -1 | sed 's/%2F/\//g; s/%20/ /g')
        case "$_rel" in ""|*..*) cors; printf '{"ok":false,"error":"bad path"}\n'; exit 0 ;; esac
        _idx="$CAT/index.json"
        # index.json 里按 path 找到 url（path 形如 kind/file）
        _url=$(tr ',' '\n' < "$_idx" 2>/dev/null | awk -v p="\"path\":\"$_rel\"" 'index($0,p){print; exit}' | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
        [ -n "$_url" ] || _url=$(tr '{' '\n' < "$_idx" 2>/dev/null | awk -v p="\"path\":\"$_rel\"" 'index($0,p){print; exit}' | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
        _base=$(basename "$_rel")
        # 优先用模块内置副本（离线可用），没有再联网拉取
        if [ -s "$CAT/$_rel" ]; then
            cp -f "$CAT/$_rel" "$DIR/$_base" 2>/dev/null
        elif [ -n "$_url" ] && command -v curl >/dev/null 2>&1; then
            curl -fsSL --max-time 25 -A "Mozilla/5.0" "$_url" -o "$DIR/$_base" 2>/dev/null
        fi
        if [ -s "$DIR/$_base" ]; then
            chmod 644 "$DIR/$_base" 2>/dev/null
            rm -f "$DIR/.$_base.off" 2>/dev/null
            do_apply >/dev/null 2>&1
            cors; printf '{"ok":true,"name":"%s"}\n' "$(json_escape "$_base")"
        else
            rm -f "$DIR/$_base" 2>/dev/null
            cors; printf '{"ok":false,"error":"下载失败"}\n'
        fi
        exit 0
        ;;    *read=*)
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^read=//p' | head -1 | sed 's/%20/ /g')
        case "$_n" in ""|*/*|*..*) printf 'Content-Type: text/plain; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\n\r\n'; exit 0 ;; esac
        printf 'Content-Type: text/plain; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\n\r\n'
        [ -f "$DIR/$_n" ] && cat "$DIR/$_n"
        exit 0
        ;;
    *toggle=*)
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^toggle=//p' | head -1 | sed 's/%20/ /g')
        case "$_n" in ""|*/*|*..*) cors; printf '{"ok":false,"error":"bad name"}\n'; exit 0 ;; esac
        [ -f "$DIR/$_n" ] || { cors; printf '{"ok":false,"error":"not found"}\n'; exit 0; }
        if [ -f "$DIR/.$_n.off" ]; then rm -f "$DIR/.$_n.off"; _st=1; else : > "$DIR/.$_n.off"; _st=0; fi
        cors; printf '{"ok":true,"name":"%s","enabled":%s}\n' "$(json_escape "$_n")" "$_st"
        exit 0
        ;;
    *del=*)
        _n=$(printf '%s' "$Q" | tr '&' '\n' | sed -n 's/^del=//p' | head -1 | sed 's/%20/ /g')
        case "$_n" in ""|*/*|*..*|.*) cors; printf '{"ok":false,"error":"bad name"}\n'; exit 0 ;; esac
        if [ -f "$DIR/$_n" ]; then
            rm -f "$DIR/$_n" "$DIR/.$_n.off" 2>/dev/null
            do_apply >/dev/null 2>&1
            cors; printf '{"ok":true,"deleted":"%s"}\n' "$(json_escape "$_n")"
        else
            cors; printf '{"ok":false,"error":"not found"}\n'
        fi
        exit 0
        ;;
esac

cors
printf '{"dir":"%s","out":"%s","catalog":"%s","scripts":[' "$DIR" "$OUT" "$CAT"
_first=1
for f in "$DIR"/*; do
    [ -f "$f" ] || continue
    b=$(basename "$f")
    case "$b" in .*) continue ;; esac
    typ=$(fmt_of "$b")
    sz=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
    mt=$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)
    dn=$(domains_of "$b" | tr -d ' ' | tr 'A-Z' 'a-z' | sed 's/^\*\.//' | grep -E '^[a-z0-9]' | sort -u | wc -l | tr -d ' ')
    rj=$(count_reject "$b")
    en=$(enabled "$b")
    if [ $_first -eq 1 ]; then _first=0; else printf ','; fi
    printf '{"name":"%s","type":"%s","size":%s,"mtime":"%s","domains":%s,"reject_rules":%s,"enabled":%s}' \
        "$(json_escape "$b")" "$typ" "${sz:-0}" "${mt:-}" "${dn:-0}" "${rj:-0}" "$en"
done
printf ']}\n'
