.title {
    margin-bottom: 8px;
    font-weight: var(--weight-bold);
}

.container {
    padding-top: 0;
}

.checks {
    padding-top: 28px;
}

.checksTitle {
    margin-bottom: 12px;
    font-weight: var(--weight-bold);
}

.links {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.link {
    font-size: var(--fs-text-t2);
}

.note {
    margin-top: 18px;
    font-size: var(--fs-text-t2);
    line-height: var(--lh-t2-normal);
    color: var(--default-main-text);
}
